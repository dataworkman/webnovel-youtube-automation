OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024
# Scene analysis uses the same OPENAI_API_KEY; falls back to the local heuristic on failure.
OPENAI_ANALYZER_MODEL=gpt-4.1-mini

# Point this at a Google service-account JSON file, or use ADC.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_TTS_DEFAULT_VOICE=ko-KR-Chirp3-HD-Charon

# Set to require HTTP Basic auth on every page (user defaults to "admin"). Strongly recommended when the port is reachable by others.
APP_PASSWORD=
APP_USER=admin
